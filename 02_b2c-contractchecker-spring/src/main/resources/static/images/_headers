/*
  This file defines custom headers for Cloudflare Pages.
  Learn more at https://developers.cloudflare.com/pages/platform/headers/
*/

/*
  The /* path applies these headers to all pages and assets.
*/
/
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

  # Content Security Policy (CSP)
  # This policy defines which external resources are allowed to be loaded.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://*.cloudflareinsights.com https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com https://*.cloudflareinsights.com https://v1.ihrezuhauseberatung.de https://o451051429.ingest.us.sentry.io https://eu.posthog.com https://eu-assets.i.posthog.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

/*
  Caching policy for static assets.
  We apply a long cache time to assets with a hash in their filename,
  as they are considered immutable.
*/
/assets/*
  Cache-Control: public, max-age=31536000, immutable
