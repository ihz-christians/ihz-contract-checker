# ==============================================================================
# B2C AI Gateway - Environment Variables Template
# Copy this file to .env and configure your real API keys locally.
# ==============================================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Langfuse Observability & LLMOps (Optional for local dev)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# MinIO / AWS S3 Config (Local dev default points to MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=eu-central-1

# Google Cloud Storage HMAC Keys (Optional for Cloud deployment)
GCP_STORAGE_ACCESS_KEY_ID=your_gcp_access_key_here
GCP_STORAGE_SECRET_ACCESS_KEY=your_gcp_secret_key_here

# Ops Control Center Secret for M2M communication
OPS_CONTROL_SECRET=super-secure-ops-token-2026
